# Bare project URL (no /rest/v1/ suffix) — same project as the Next.js app
SUPABASE_URL=https://your-project.supabase.co

# Service role key from Supabase → Project Settings → API. This bypasses RLS,
# which is intentional: this process is the trusted authority for auction state.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — most hosts set this automatically
PORT=3001
