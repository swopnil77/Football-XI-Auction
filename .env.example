# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used server-side by scripts/seed.ts — never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — powers AI match commentary (app/api/commentary/route.ts). Without this,
# match recaps fall back to a plain templated line instead of an AI-written one.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
